% Page-flow proof frames.  Text is never collected into a nested vbox:
% zref records the boundaries and TikZ draws each visible page fragment.
% Recompile until labels settle (normally two or three runs).
\RequirePackage{zref-savepos}
\RequirePackage{zref-abspage}
\RequirePackage{needspace}
\newcount\evan@framecount
\newcount\evan@framedepth
\newdimen\evan@framewidth
\newdimen\evan@framepad
\newdimen\evan@frametop
\newdimen\evan@framebottom
\newdimen\evan@frameabove
\newdimen\evan@framebelow
\def\evan@oldframecount{0}
\zref@newprop{evanwidth}[0]{\number\evan@framewidth}
\zref@newprop{evankind}[0]{\evan@framekind}
\zref@newprop{evandepth}[0]{\the\evan@framedepth}
\zref@addprops{savepos}{abspage,evanwidth,evankind,evandepth}
\AtEndDocument{%
  \immediate\write\@auxout{\string\gdef\string\evan@oldframecount{\the\evan@framecount}}%
}
\def\evan@framemarker#1{%
  \nobreak\nointerlineskip
  \hbox to\z@{\kern\@totalleftmargin\kern-\evan@framepad\zsavepos{#1}\hss}%
  \nobreak\nointerlineskip
}
\def\evan@flowbegin#1#2{%
  \par\begingroup
  \global\advance\evan@framecount\@ne
  \edef\evan@frameid{\the\evan@framecount}%
  \def\evan@framekind{#1}%
  \advance\evan@framedepth\@ne
  \evan@framewidth=\linewidth
  \ifnum#1=0
    \evan@framepad=13.9pt
    \evan@frametop=11.9pt \evan@framebottom=12.9pt
    \evan@frameabove=10pt \evan@framebelow=11pt
    \def\evan@headingcolor{EvanNavy}%
    \pushQED{\qed}%
  \else
    \evan@framepad=11.35pt
    \evan@frametop=9.35pt \evan@framebottom=10.35pt
    \evan@frameabove=8pt \evan@framebelow=9pt
    \def\evan@headingcolor{EvanBlueDeep}%
    \pushQED{\ensuremath{\blacksquare}}%
  \fi
  \addvspace{\evan@frameabove}%
  \Needspace{5\baselineskip}%
  \list{}{%
    \leftmargin=\evan@framepad \rightmargin=\evan@framepad
    \topsep=0pt \partopsep=0pt \itemsep=0pt
    \parsep=\parskip \listparindent=\parindent
    \labelwidth=0pt \labelsep=0pt \itemindent=0pt
  }%
  \item[]\relax
  \evan@framemarker{evan-frame-\evan@frameid-start}%
  \nobreak\vskip\evan@frametop\nobreak
  \clubpenalty=10000 \widowpenalty=10000
  \noindent{\sffamily\bfseries\color{\evan@headingcolor}#2.}\enspace
  \normalfont\ignorespaces
}
\def\evan@flowend{%
  % Use the ordinary QED placement; no special ending protection.
  \popQED\par
  \vskip\evan@framebottom
  \evan@framemarker{evan-frame-\evan@frameid-end}%
  \endlist
  \par\addvspace{\evan@framebelow}%
  \endgroup\ignorespacesafterend
}
\renewenvironment{proof}[1][Proof]
  {\evan@flowbegin{0}{#1}}{\evan@flowend}
\renewenvironment{subproof}[1][Proof]
  {\evan@flowbegin{1}{#1}}{\evan@flowend}
\def\evan@drawflowframes{%
  \ifnum\evan@oldframecount>0
  \begin{tikzpicture}[remember picture,overlay]
    \coordinate (evan-page-origin) at (current page.south west);
    \foreach \evan@i in {1,...,\evan@oldframecount}{%
      \edef\evan@startlabel{evan-frame-\evan@i-start}%
      \edef\evan@endlabel{evan-frame-\evan@i-end}%
      \edef\evan@firstpage{\zref@extractdefault{\evan@startlabel}{abspage}{0}}%
      \edef\evan@lastpage{\zref@extractdefault{\evan@endlabel}{abspage}{0}}%
      \ifnum\evan@firstpage>0
      \ifnum\c@abspage<\evan@firstpage\else
      \ifnum\c@abspage>\evan@lastpage\else
        \edef\evan@kind{\zref@extractdefault{\evan@startlabel}{evankind}{0}}%
        \edef\evan@depth{\zref@extractdefault{\evan@startlabel}{evandepth}{1}}%
        \ifnum\evan@kind=0
          \def\evan@edge{EvanNavy}\def\evan@fill{EvanSkyDeep!74!white}%
          \def\evan@shadow{EvanNavy!25!black}%
          \def\evan@rule{1.9pt}\def\evan@radius{9pt}\def\evan@shiftsize{3pt}%
        \else
          \def\evan@edge{EvanBlueDeep}\def\evan@fill{EvanSky!82!white}%
          \def\evan@shadow{EvanBlue!20!black}%
          \def\evan@rule{1.35pt}\def\evan@radius{7pt}\def\evan@shiftsize{2pt}%
        \fi
        \pgfmathsetlengthmacro\evan@xleft{\zposx{\evan@startlabel}sp}%
        \pgfmathsetlengthmacro\evan@xright{\evan@xleft+\zref@extractdefault{\evan@startlabel}{evanwidth}{0}sp}%
        \ifnum\c@abspage=\evan@firstpage
          \pgfmathsetlengthmacro\evan@ytop{\zposy{\evan@startlabel}sp}%
          \def\evan@extendtop{0pt}%
        \else
          \pgfmathsetlengthmacro\evan@ytop{\paperheight-1in-\voffset-\topmargin-\headheight-\headsep}%
          \let\evan@extendtop\evan@radius
        \fi
        \ifnum\c@abspage=\evan@lastpage
          \pgfmathsetlengthmacro\evan@ybottom{\zposy{\evan@endlabel}sp}%
          \def\evan@extendbottom{0pt}%
        \else
          \pgfmathsetlengthmacro\evan@ybottom{\paperheight-1in-\voffset-\topmargin-\headheight-\headsep-\textheight}%
          \let\evan@extendbottom\evan@radius
        \fi
        \begin{scope}[shift={(evan-page-origin)}]
          \clip (\evan@xleft-\evan@rule,\evan@ybottom-\evan@shiftsize-\evan@rule)
             rectangle (\evan@xright+\evan@shiftsize+\evan@rule,\evan@ytop+\evan@rule);
          \path[fill=\evan@fill,draw=\evan@edge,line width=\evan@rule,rounded corners=\evan@radius]
            (\evan@xleft,\evan@ybottom-\evan@extendbottom)
            rectangle (\evan@xright,\evan@ytop+\evan@extendtop);
        \end{scope}%
      \fi\fi\fi
    }%
  \end{tikzpicture}%
  \fi
}
